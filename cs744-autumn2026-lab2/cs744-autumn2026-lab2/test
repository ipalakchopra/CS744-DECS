#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <sys/types.h>
#include <sys/wait.h>
#include <fcntl.h>

#define MAX_INPUT_SIZE 1024
#define MAX_TOKEN_SIZE 64
#define MAX_NUM_TOKENS 64

char **tokenize(char *line)
{
    char **tokens = (char **)malloc(MAX_NUM_TOKENS * sizeof(char *));
    char *token = (char *)malloc(MAX_TOKEN_SIZE * sizeof(char));

    int i, tokenIndex = 0, tokenNo = 0;

    for (i = 0; i < strlen(line); i++)
    {
        char ch = line[i];

        if (ch == ' ' || ch == '\t' || ch == '\n')
        {
            token[tokenIndex] = '\0';

            if (tokenIndex != 0)
            {
                tokens[tokenNo] = (char *)malloc(MAX_TOKEN_SIZE);
                strcpy(tokens[tokenNo], token);
                tokenNo++;
                tokenIndex = 0;
            }
        }
        else
        {
            token[tokenIndex++] = ch;
        }
    }

    free(token);
    tokens[tokenNo] = NULL;

    return tokens;
}

void free_tokens(char **tokens)
{
    int i;

    for (i = 0; tokens[i] != NULL; i++)
        free(tokens[i]);

    free(tokens);
}

int run_command(char **tokens, int background)
{
    int i;
    int argc = 0;

    while (tokens[argc] != NULL)
        argc++;

    if (argc == 0)
        return 0;

    pid_t pid = fork();

    if (pid < 0)
    {
        perror("fork");
        return 1;
    }

    if (pid == 0)
    {
        for (i = 0; tokens[i] != NULL; i++)
        {
            if (strcmp(tokens[i], "<") == 0)
            {
                if (tokens[i + 1] == NULL)
                {
                    printf("Execution failed\n");
                    exit(1);
                }

                int fd = open(tokens[i + 1], O_RDONLY);

                if (fd < 0)
                {
                    printf("Execution failed\n");
                    exit(1);
                }

                if (dup2(fd, STDIN_FILENO) < 0)
                {
                    close(fd);
                    printf("Execution failed\n");
                    exit(1);
                }

                close(fd);

                tokens[i] = NULL;
                break;
            }

            if (strcmp(tokens[i], ">") == 0)
            {
                if (tokens[i + 1] == NULL)
                {
                    printf("Execution failed\n");
                    exit(1);
                }

                int fd = open(tokens[i + 1],
                              O_WRONLY | O_CREAT | O_TRUNC,
                              0644);

                if (fd < 0)
                {
                    printf("Execution failed\n");
                    exit(1);
                }

                if (dup2(fd, STDOUT_FILENO) < 0)
                {
                    close(fd);
                    printf("Execution failed\n");
                    exit(1);
                }

                close(fd);

                tokens[i] = NULL;
                break;
            }
        }

        execvp(tokens[0], tokens);

        printf("Execution failed\n");
        exit(1);
    }

    if (background)
    {
        printf("[background] started pid %d\n", pid);
        return 0;
    }

    int status;

    if (waitpid(pid, &status, 0) < 0)
        return 1;

    if (WIFEXITED(status))
    {
        int exit_status = WEXITSTATUS(status);
        printf("[exit status: %d]\n", exit_status);
        return exit_status;
    }

    return 1;
}

int main()
{
    char line[MAX_INPUT_SIZE];
    char **tokens;
    int i;

    while (1)
    {
        int status = 0;

        printf("shell> ");
        fflush(stdout);

        if (fgets(line, sizeof(line), stdin) == NULL)
            break;

        tokens = tokenize(line);

        if (tokens[0] == NULL)
        {
            free(tokens);
            continue;
        }

        if (strcmp(tokens[0], "exit") == 0)
        {
            free_tokens(tokens);
            printf("exiting\n");
            break;
        }

        char *commands[MAX_NUM_TOKENS];
        int command_count = 0;
        int start = 0;

        for (i = 0; tokens[i] != NULL; i++)
        {
            if (strcmp(tokens[i], "&&") == 0)
            {
                tokens[i] = NULL;
                commands[command_count++] = tokens[start];
                start = i + 1;
            }
        }

        commands[command_count++] = tokens[start];

        for (i = 0; i < command_count; i++)
        {
            char **command_tokens;

            if (i == 0)
                command_tokens = tokens;
            else
            {
                int j;
                command_tokens = &tokens[0];

                for (j = 0; j < MAX_NUM_TOKENS; j++)
                {
                    if (tokens[j] == commands[i])
                    {
                        command_tokens = &tokens[j];
                        break;
                    }
                }
            }

            int argc = 0;

            while (command_tokens[argc] != NULL)
                argc++;

            int background = 0;

            if (argc > 0 &&
                strcmp(command_tokens[argc - 1], "&") == 0)
            {
                background = 1;
                free(command_tokens[argc - 1]);
                command_tokens[argc - 1] = NULL;
            }

            status = run_command(command_tokens, background);

            if (status != 0)
                break;
        }

        while (waitpid(-1, NULL, WNOHANG) > 0)
        {
        }

        free_tokens(tokens);
    }

    return 0;
}